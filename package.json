{
  "name": "winterhof",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node ./node_modules/@assetpack/core/bin/index.js",
    "dev": "npm run assets && node ./node_modules/vite/bin/vite.js --host 127.0.0.1 --port 8085",
    "build": "npm run assets && node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview --host 127.0.0.1 --port 8085",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "typecheck": "node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "lint": "node ./node_modules/eslint/bin/eslint.js src/core src/render tests playwright.config.ts",
    "test:browser": "node ./node_modules/@playwright/test/cli.js test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "pixi.js": "^8.10.2"
  },
  "devDependencies": {
    "@assetpack/core": "^1.7.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "eslint": "^9.39.5",
    "sharp": "^0.34.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.2.0",
    "vitest": "^2.1.8"
  }
}
